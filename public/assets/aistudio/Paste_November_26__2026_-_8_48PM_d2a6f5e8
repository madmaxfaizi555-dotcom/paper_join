        let pageIndices;
        
        if (mode === 'all') {
            // Download each page as separate PDF
            for (let i = 0; i < splitPageCount; i++) {
                updateProgress((i / splitPageCount) * 100);
                const newPdf = await PDFLib.PDFDocument.create();
                const [page] = await newPdf.copyPages(srcPdf, [i]);
                newPdf.addPage(page);
                const bytes = await newPdf.save();
                const blob = new Blob([bytes], { type: 'application/pdf' });
                downloadBlob(blob, `page_${i + 1}.pdf`);
            }
            hideLoader();
            showToast(`${splitPageCount} pages extracted!`, 'success');
            return;
        } else if (mode === 'range') {
            const from = parseInt(document.getElementById('split-from').value) - 1;
            const to = parseInt(document.getElementById('split-to').value) - 1;
            pageIndices = [];
            for (let i = from; i <= to; i++) pageIndices.push(i);
        } else {
            const customInput = document.getElementById('split-custom').value;
            pageIndices = parsePageRanges(customInput, splitPageCount);
        }
        
        if (pageIndices.length === 0) {
            hideLoader();
            showToast('No valid pages selected', 'warning');
            return;
        }
        
        const newPdf = await PDFLib.PDFDocument.create();
        const pages = await newPdf.copyPages(srcPdf, pageIndices);
        pages.forEach(page => newPdf.addPage(page));
        
        updateProgress(90);
        const bytes = await newPdf.save();
        const blob = new Blob([bytes], { type: 'application/pdf' });
        
        hideLoader();
        downloadBlob(blob, 'split_pages.pdf');
        showToast(`Extracted ${pageIndices.length} pages!`, 'success');
    } catch (error) {
        hideLoader();
        showToast('Error splitting PDF: ' + error.message, 'error');
    }
}

