async function executeCompress() {
    if (!compressFile) return;
    
    showLoader('Compressing PDF...');
    
    try {
        const bytes = await compressFile.arrayBuffer();
        const pdfDoc = await PDFLib.PDFDocument.load(bytes, { ignoreEncryption: true });
        
        // Remove metadata and optimize
        pdfDoc.setTitle('');
        pdfDoc.setAuthor('');
        pdfDoc.setSubject('');
        pdfDoc.setKeywords([]);
        pdfDoc.setProducer('');
        pdfDoc.setCreator('');
        
        updateProgress(50);
        
        const compressedBytes = await pdfDoc.save({
            useObjectStreams: true,
            addDefaultPage: false,
            objectsPerTick: 100
        });
        
        updateProgress(100);
        
        const blob = new Blob([compressedBytes], { type: 'application/pdf' });
        const originalSize = compressFile.size;
        const newSize = blob.size;
        const savings = ((originalSize - newSize) / originalSize * 100).toFixed(1);
        
        hideLoader();
        
        window.lastCompressBlob = blob;
        
        document.getElementById('compress-result').innerHTML = `
            <div class="result-area">
                <h3><i class="fas fa-check-circle"></i> PDF Compressed!</h3>
                <p class="result-info">
                    Original: ${formatFileSize(originalSize)} → Compressed: ${formatFileSize(newSize)}<br>
                    Saved: ${savings > 0 ? savings : 0}% ${savings > 0 ? '✓' : '(already optimized)'}
