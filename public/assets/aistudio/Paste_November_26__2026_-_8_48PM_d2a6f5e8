}

function handleGlobalDrop(event) {
    event.preventDefault();
    event.currentTarget.classList.remove('drag-over');
    const files = Array.from(event.dataTransfer.files);
    if (files.length > 0) handlePastedFiles(files);
}

function handleToolDrop(event, toolName) {
    event.preventDefault();
    event.currentTarget.classList.remove('drag-over');
    const files = Array.from(event.dataTransfer.files);
    if (files.length === 0) return;

    switch(toolName) {
        case 'merge': handleMergeFiles(files); break;
        case 'split': if(files[0]) handleSplitFile(files[0]); break;
        case 'compress': if(files[0]) handleCompressFile(files[0]); break;
