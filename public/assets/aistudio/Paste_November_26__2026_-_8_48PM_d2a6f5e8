let i2pFiles = [];

function initImageToPdfTool() {
    i2pFiles = [];
}

function handleI2PFiles(fileList) {
    const files = Array.from(fileList).filter(f => f.type.startsWith('image/'));
    i2pFiles.push(...files);
    renderI2PFileList();
}

function renderI2PFileList() {
    const list = document.getElementById('i2p-file-list');
    const options = document.getElementById('i2p-options');
    
    if (i2pFiles.length === 0) {
        list.innerHTML = '';
        options.style.display = 'none';
        return;
    }
    
    options.style.display = 'block';
    list.innerHTML = i2pFiles.map((f, i) => `
        <div class="file-list-item">
            <span class="drag-handle"><i class="fas fa-grip-vertical"></i></span>
            <span class="file-name"><i class="fas fa-file-image" style="color:var(--accent)"></i> ${f.name}</span>
            <span class="file-size">${formatFileSize(f.size)}</span>
            <button class="remove-btn" onclick="i2pFiles.splice(${i},1);renderI2PFileList();"><i class="fas fa-times"></i></button>
        </div>
    `).join('');
}

async function executeI2P() {
    if (i2pFiles.length === 0) return;
    
    showLoader('Creating PDF from images...');
    
    try {
        const pdfDoc = await PDFLib.PDFDocument.create();
        const margin = parseInt(document.getElementById('i2p-margin').value);
        const pageSize = document.getElementById('i2p-size').value;
        const orientation = document.getElementById('i2p-orientation').value;
        
        for (let i = 0; i < i2pFiles.length; i++) {
            updateProgress((i / i2pFiles.length) * 90);
            
            const file = i2pFiles[i];
            const imgBytes = await file.arrayBuffer();
            
            let image;
            if (file.type === 'image/png') {
                image = await pdfDoc.embedPng(imgBytes);
            } else {
                // Convert to JPEG-compatible format
                const blob = new Blob([imgBytes], { type: file.type });
                const bitmap = await createImageBitmap(blob);
                const canvas = document.createElement('canvas');
                canvas.width = bitmap.width;
                canvas.height = bitmap.height;
                canvas.getContext('2d').drawImage(bitmap, 0, 0);
                
                const jpegBlob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.92));
                const jpegBytes = await jpegBlob.arrayBuffer();
                image = await pdfDoc.embedJpg(jpegBytes);
            }
            
            let pageWidth, pageHeight;
            
            if (pageSize === 'fit') {
                pageWidth = image.width + margin * 2;
                pageHeight = image.height + margin * 2;
            } else {
                const sizes = {
                    a4: [595.28, 841.89],
                    letter: [612, 792]
                };
                [pageWidth, pageHeight] = sizes[pageSize];
                
                const imgRatio = image.width / image.height;
                const usePortrait = orientation === 'auto' ? (imgRatio < 1) : (orientation === 'portrait');
                
                if (!usePortrait) {
                    [pageWidth, pageHeight] = [pageHeight, pageWidth];
                }
            }
            
            const page = pdfDoc.addPage([pageWidth, pageHeight]);
            
            const availW = pageWidth - margin * 2;
            const availH = pageHeight - margin * 2;
            const scale = Math.min(availW / image.width, availH / image.height);
            const drawW = image.width * scale;
            const drawH = image.height * scale;
            
            page.drawImage(image, {
                x: (pageWidth - drawW) / 2,
                y: (pageHeight - drawH) / 2,
                width: drawW,
                height: drawH
            });
        }
        
        updateProgress(95);
        const pdfBytes = await pdfDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        
        hideLoader();
        window.lastI2PBlob = blob;
        
        document.getElementById('i2p-result').innerHTML = `
            <div class="result-area">
                <h3><i class="fas fa-check-circle"></i> PDF Created!</h3>
                <p class="result-info">${i2pFiles.length} images → ${formatFileSize(blob.size)}</p>
                <button class="btn btn-primary btn-lg" onclick="downloadBlob(lastI2PBlob, 'images.pdf')">
                    <i class="fas fa-download"></i> Download PDF
                </button>
            </div>
        `;
        
        showToast('PDF created successfully!', 'success');
    } catch (error) {
        hideLoader();
        showToast('Error creating PDF: ' + error.message, 'error');
    }
}

