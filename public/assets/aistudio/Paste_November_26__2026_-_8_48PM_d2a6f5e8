async function renderSplitPreview(bytes) {
    const container = document.getElementById('split-preview');
    const loadingTask = pdfjsLib.getDocument({ data: bytes });
    const pdf = await loadingTask.promise;
    
    let html = '';
    const maxPreview = Math.min(pdf.numPages, 20);
    
    for (let i = 1; i <= maxPreview; i++) {
        const page = await pdf.getPage(i);
        const viewport = page.getViewport({ scale: 0.5 });
        const canvas = document.createElement('canvas');
        canvas.width = viewport.width;
        canvas.height = viewport.height;
        
        await page.render({
            canvasContext: canvas.getContext('2d'),
            viewport: viewport
        }).promise;
        
        html += `
            <div class="preview-item" onclick="this.classList.toggle('selected')">
                <img src="${canvas.toDataURL()}" alt="Page ${i}">
                <div class="preview-label">Page ${i}</div>
            </div>
        `;
    }
    
    if (pdf.numPages > 20) {
        html += `<div class="preview-item"><div class="preview-label" style="padding:40px">+${pdf.numPages - 20} more pages</div></div>`;
    }
    
    container.innerHTML = html;
