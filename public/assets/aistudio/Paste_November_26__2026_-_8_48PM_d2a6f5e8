function initMergeTool() { mergeFiles = []; }

function handleMergeFiles(fileList) {
    Array.from(fileList).filter(f => f.type === 'application/pdf').forEach(f => mergeFiles.push(f));
    renderMergeList();
}
function renderMergeList() {
    const list = document.getElementById('merge-file-list');
    const acts = document.getElementById('merge-actions');
    if (!mergeFiles.length) { list.innerHTML = ''; acts.style.display = 'none'; return; }
    acts.style.display = 'flex';
    list.innerHTML = mergeFiles.map((f, i) => `
        <div class="file-list-item" draggable="true" ondragstart="mDragStart(event,${i})" ondragover="event.preventDefault()" ondrop="mDrop(event,${i})">
            <span class="drag-handle"><i class="fas fa-grip-vertical"></i></span>
            <span class="file-name"><i class="fas fa-file-pdf" style="color:var(--danger)"></i> ${f.name}</span>
            <span class="file-size">${formatFileSize(f.size)}</span>
            <button class="remove-btn" onclick="mergeFiles.splice(${i},1);renderMergeList()"><i class="fas fa-times"></i></button>
        </div>`).join('');
}
let _mdi = null;
function mDragStart(e, i) { _mdi = i; e.dataTransfer.effectAllowed = 'move'; }
function mDrop(e, i) { e.preventDefault(); if (_mdi === null) return; const it = mergeFiles.splice(_mdi, 1)[0]; mergeFiles.splice(i, 0, it); renderMergeList(); }

async function executeMerge() {
