async function executePageNumbers() {
    if (!pnData) return;
    showLoader('Adding page numbers...');
    try {
        const pdf = await PDFLib.PDFDocument.load(pnData, { ignoreEncryption: true });
        const font = await pdf.embedFont(PDFLib.StandardFonts.Helvetica);
        const pos = document.getElementById('pn-pos').value;
        const fmt = document.getElementById('pn-fmt').value;
        const startNum = parseInt(document.getElementById('pn-start').value);
        const fontSize = parseInt(document.getElementById('pn-size').value);
