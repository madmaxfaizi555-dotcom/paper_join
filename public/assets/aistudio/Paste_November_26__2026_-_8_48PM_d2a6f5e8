let rotateFileData = null;

function initRotateTool() {
    rotateFileData = null;
    document.addEventListener('change', function(e) {
        if (e.target.id === 'rotate-pages') {
            const customGroup = document.getElementById('rotate-custom-group');
            if (customGroup) {
                customGroup.style.display = e.target.value === 'custom' ? 'block' : 'none';
            }
        }
    });
}

async function handleRotateFile(file) {
    if (!file) return;
    rotateFileData = await file.arrayBuffer();
    document.getElementById('rotate-options').style.display = 'block';
    showToast('PDF loaded', 'success');
}

async function executeRotate() {
    if (!rotateFileData) return;
    
    showLoader('Rotating PDF...');
    
    try {
        const pdfDoc = await PDFLib.PDFDocument.load(rotateFileData, { ignoreEncryption: true });
        const angle = parseInt(document.getElementById('rotate-angle').value);
        const applyTo = document.getElementById('rotate-pages').value;
        const pages = pdfDoc.getPages();
        
        pages.forEach((page, i) => {
            let shouldRotate = false;
            
            if (applyTo === 'all') shouldRotate = true;
            else if (applyTo === 'even') shouldRotate = (i + 1) % 2 === 0;
            else if (applyTo === 'odd') shouldRotate = (i + 1) % 2 !== 0;
            else if (applyTo === 'custom') {
                const customPages = parsePageRanges(document.getElementById('rotate-custom').value, pages.length);
                shouldRotate = customPages.includes(i);
            }
            
            if (shouldRotate) {
                const currentRotation = page.getRotation().angle;
                page.setRotation(PDFLib.degrees(currentRotation + angle));
            }
        });
        
        const bytes = await pdfDoc.save();
        const blob = new Blob([bytes], { type: 'application/pdf' });
        
        hideLoader();
        window.lastRotateBlob = blob;
        
        document.getElementById('rotate-result').innerHTML = `
            <div class="result-area">
                <h3><i class="fas fa-check-circle"></i> PDF Rotated!</h3>
                <button class="btn btn-primary btn-lg" onclick="downloadBlob(lastRotateBlob, 'rotated.pdf')">
                    <i class="fas fa-download"></i> Download Rotated PDF
                </button>
            </div>
        `;
        
        showToast('PDF rotated successfully!', 'success');
    } catch (error) {
        hideLoader();
        showToast('Error rotating PDF: ' + error.message, 'error');
    }
}

