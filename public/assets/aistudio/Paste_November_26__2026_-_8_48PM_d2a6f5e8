function initImageToPdfTool() { i2pFiles = []; }
function handleI2PFiles(fileList) {
    Array.from(fileList).filter(f => f.type.startsWith('image/')).forEach(f => i2pFiles.push(f));
    renderI2PList();
}
function renderI2PList() {
    const list = document.getElementById('i2p-list');
    const opts = document.getElementById('i2p-opts');
    if (!i2pFiles.length) { list.innerHTML = ''; opts.style.display = 'none'; return; }
    opts.style.display = 'block';
    list.innerHTML = i2pFiles.map((f, i) => `
        <div class="file-list-item"><span class="drag-handle"><i class="fas fa-grip-vertical"></i></span>
        <span class="file-name"><i class="fas fa-file-image" style="color:var(--accent)"></i> ${f.name}</span>
        <span class="file-size">${formatFileSize(f.size)}</span>
        <button class="remove-btn" onclick="i2pFiles.splice(${i},1);renderI2PList()"><i class="fas fa-times"></i></button></div>`).join('');
}

async function executeI2P() {
    if (!i2pFiles.length) return;
    showLoader('Creating PDF...');
    try {
        const pdf = await PDFLib.PDFDocument.create();
        const margin = parseInt(document.getElementById('i2p-margin').value);
        const pageSize = document.getElementById('i2p-size').value;
        const orient = document.getElementById('i2p-orient').value;
        for (let i = 0; i < i2pFiles.length; i++) {
            updateProgress((i / i2pFiles.length) * 90);
            const file = i2pFiles[i];
            const imgBytes = await file.arrayBuffer();
            let image;
            if (file.type === 'image/png') { image = await pdf.embedPng(imgBytes); }
            else {
                const blob = new Blob([imgBytes], { type: file.type });
                const bitmap = await createImageBitmap(blob);
                const canvas = document.createElement('canvas'); canvas.width = bitmap.width; canvas.height = bitmap.height;
                canvas.getContext('2d').drawImage(bitmap, 0, 0);
                const jpgBlob = await new Promise(r => canvas.toBlob(r, 'image/jpeg', 0.92));
                image = await pdf.embedJpg(await jpgBlob.arrayBuffer());
            }
            let pw, ph;
            if (pageSize === 'fit') { pw = image.width + margin * 2; ph = image.height + margin * 2; }
            else {
                const sizes = { a4: [595.28, 841.89], letter: [612, 792] };
                [pw, ph] = sizes[pageSize];
                const usePortrait = orient === 'auto' ? (image.width / image.height < 1) : (orient === 'portrait');
                if (!usePortrait) [pw, ph] = [ph, pw];
            }
            const page = pdf.addPage([pw, ph]);
            const aw = pw - margin * 2, ah = ph - margin * 2;
            const scale = Math.min(aw / image.width, ah / image.height);
            const dw = image.width * scale, dh = image.height * scale;
            page.drawImage(image, { x: (pw - dw) / 2, y: (ph - dh) / 2, width: dw, height: dh });
        }
        updateProgress(95);
        const out = await pdf.save();
        const blob = new Blob([out], { type: 'application/pdf' });
        hideLoader(); window._i2pBlob = blob;
        document.getElementById('i2p-result').innerHTML = `
            <div class="result-area"><h3><i class="fas fa-check-circle"></i> PDF Created!</h3>
            <p class="result-info">${i2pFiles.length} images &bull; ${formatFileSize(blob.size)}</p>
            <button class="btn btn-primary btn-lg" onclick="downloadBlob(_i2pBlob,'images.pdf')"><i class="fas fa-download"></i> Download PDF</button></div>`;
        showToast('PDF created!', 'success');
    } catch (err) { hideLoader(); showToast('Error: ' + err.message, 'error'); }
}

