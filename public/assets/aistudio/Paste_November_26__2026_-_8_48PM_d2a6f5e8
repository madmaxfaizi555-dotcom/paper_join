let dragMergeIdx = null;
function dragMergeStart(e, idx) { dragMergeIdx = idx; e.dataTransfer.effectAllowed = 'move'; }
function dragMergeOver(e, idx) { e.preventDefault(); }
function dragMergeDrop(e, idx) {
    e.preventDefault();
    if (dragMergeIdx === null) return;
    const item = mergeFiles.splice(dragMergeIdx, 1)[0];
    mergeFiles.splice(idx, 0, item);
