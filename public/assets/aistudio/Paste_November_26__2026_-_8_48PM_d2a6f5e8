                    <div class="option-group"><label>To:</label><input type="number" id="s-to" min="1" value="1"></div>
                </div>
                <div class="option-group" id="split-custom" style="display:none">
                    <label>Pages:</label><input type="text" id="s-pages" placeholder="1,3,5-8,12">
                </div>
            </div>
            <div id="split-preview" class="preview-grid"></div>
            <div class="tool-action-bar"><button class="btn btn-primary btn-lg" onclick="executeSplit()"><i class="fas fa-cut"></i> Split PDF</button></div>
        </div>
        <div id="split-result"></div>`;
}
function initSplitTool() { splitData = null; splitCount = 0; }

async function handleSplitFile(file) {
    if (!file || file.type !== 'application/pdf') { showToast('Select a valid PDF', 'warning'); return; }
    showLoader('Loading PDF...');
    try {
        const bytes = await file.arrayBuffer();
        splitData = bytes;
        const pdf = await PDFLib.PDFDocument.load(bytes, { ignoreEncryption: true });
        splitCount = pdf.getPageCount();
        document.getElementById('s-to').value = splitCount;
        document.getElementById('s-to').max = splitCount;
        document.getElementById('s-from').max = splitCount;
        document.getElementById('split-options').style.display = 'block';
        // Preview
        const container = document.getElementById('split-preview');
        const pdfjs = await pdfjsLib.getDocument({ data: bytes }).promise;
        let html = '';
        const max = Math.min(pdfjs.numPages, 20);
        for (let i = 1; i <= max; i++) {
            const page = await pdfjs.getPage(i);
            const vp = page.getViewport({ scale: 0.4 });
            const c = document.createElement('canvas'); c.width = vp.width; c.height = vp.height;
            await page.render({ canvasContext: c.getContext('2d'), viewport: vp }).promise;
            html += `<div class="preview-item"><img src="${c.toDataURL()}"><div class="preview-label">Page ${i}</div></div>`;
        }
        if (pdfjs.numPages > 20) html += `<div class="preview-item"><div class="preview-label" style="padding:80px 10px">+${pdfjs.numPages - 20} more</div></div>`;
        container.innerHTML = html;
        hideLoader();
        showToast(`PDF loaded: ${splitCount} pages`, 'success');
    } catch (err) { hideLoader(); showToast('Error: ' + err.message, 'error'); }
}

async function executeSplit() {
    if (!splitData) return;
    const mode = document.getElementById('split-mode').value;
    showLoader('Splitting PDF...');
    try {
        const src = await PDFLib.PDFDocument.load(splitData, { ignoreEncryption: true });
        if (mode === 'all') {
            for (let i = 0; i < splitCount; i++) {
                updateProgress((i / splitCount) * 100);
                const d = await PDFLib.PDFDocument.create();
                const [p] = await d.copyPages(src, [i]); d.addPage(p);
                const b = await d.save();
                downloadBlob(new Blob([b], { type: 'application/pdf' }), `page_${i + 1}.pdf`);
            }
        } else {
            let indices;
            if (mode === 'range') {
                const from = parseInt(document.getElementById('s-from').value) - 1;
                const to = parseInt(document.getElementById('s-to').value) - 1;
                indices = []; for (let i = from; i <= to; i++) indices.push(i);
            } else {
                indices = parsePageRanges(document.getElementById('s-pages').value, splitCount);
            }
            if (!indices.length) { hideLoader(); showToast('No valid pages', 'warning'); return; }
            const d = await PDFLib.PDFDocument.create();
            const pages = await d.copyPages(src, indices);
            pages.forEach(p => d.addPage(p));
            const b = await d.save();
            downloadBlob(new Blob([b], { type: 'application/pdf' }), 'split_pages.pdf');
        }
        hideLoader(); showToast('Split complete!', 'success');
    } catch (err) { hideLoader(); showToast('Error: ' + err.message, 'error'); }
}

