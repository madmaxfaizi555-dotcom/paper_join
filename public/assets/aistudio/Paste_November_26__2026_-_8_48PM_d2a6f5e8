async function executeWatermark() {
    if (!wmFileData) return;
    
    showLoader('Adding watermark...');
    
    try {
        const pdfDoc = await PDFLib.PDFDocument.load(wmFileData, { ignoreEncryption: true });
        const text = document.getElementById('wm-text').value || 'WATERMARK';
        const fontSize = parseInt(document.getElementById('wm-size').value);
        const opacity = parseInt(document.getElementById('wm-opacity').value) / 100;
        const rotation = parseInt(document.getElementById('wm-rotation').value);
        const colorHex = document.getElementById('wm-color').value;
        
        const r = parseInt(colorHex.slice(1, 3), 16) / 255;
        const g = parseInt(colorHex.slice(3, 5), 16) / 255;
        const b = parseInt(colorHex.slice(5, 7), 16) / 255;
        
        const font = await pdfDoc.embedFont(PDFLib.StandardFonts.Helvetica);
        const pages = pdfDoc.getPages();
        
        pages.forEach((page, i) => {
            updateProgress((i / pages.length) * 90);
            const { width, height } = page.getSize();
            const textWidth = font.widthOfTextAtSize(text, fontSize);
            
            page.drawText(text, {
                x: width / 2 - textWidth / 2,
                y: height / 2,
                size: fontSize,
                font: font,
                color: PDFLib.rgb(r, g, b),
                opacity: opacity,
                rotate: PDFLib.degrees(rotation),
            });
        });
        
        const bytes = await pdfDoc.save();
        const blob = new Blob([bytes], { type: 'application/pdf' });
        
        hideLoader();
        window.lastWmBlob = blob;
        
