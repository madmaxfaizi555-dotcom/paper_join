                    <div class="option-group"><label>Margin:</label><select id="i2p-margin"><option value="0">None</option><option value="20" selected>Small</option><option value="40">Medium</option><option value="60">Large</option></select></div>
                </div>
            </div>
            <div class="tool-action-bar"><button class="btn btn-primary btn-lg" onclick="executeI2P()"><i class="fas fa-file-pdf"></i> Create PDF</button></div>
        </div>
